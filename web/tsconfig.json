{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@theme/*": ["../theme/*"],
      "@map/*": ["../map-client/src/*"]
    }
  },
  "include": ["src", "../theme", "vite.config.ts"]
}
