# Flowcast configuration: everything the server, map and dashboard read, in one place.
#
# Locally: copy this to .env (gitignored) and fill it in. `npm start`, the server's own scripts
# and the web dev server all read it. On Railway: set the same names under the service's
# Variables instead; no file needed.
#
# Then run `npm run doctor` (or `railway run npm run doctor`): it checks every value and prints
# exactly what to paste into Google Cloud and Supabase.

# --- Required for the dashboard, accounts and sign-in -----------------------------------------
# PostgreSQL. Tables and data are set up automatically when the server starts.
# Railway: add a PostgreSQL service and set this to ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# Supabase → Project Settings → API. The Project URL and the PUBLISHABLE key (sb_publishable_…).
# The key is sent to every browser: never put a secret or service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Optional ----------------------------------------------------------------------------------
# Ask Flowcast and voice. Without it they say they're unavailable; everything else works.
OPENAI_KEY=

# Textured 3D buildings on the map: a public Mapbox token (pk.…). Read when the app is built,
# so redeploy after changing it.
VITE_MAPBOX_TOKEN=

# A higher MBTA rate limit for live transit.
VITE_MBTA_API_KEY=

# Your public address, only used by `npm run doctor` to fill in the URLs to paste.
# Not needed on Railway (it reads RAILWAY_PUBLIC_DOMAIN).
# PUBLIC_URL=https://flowcast.example.com
