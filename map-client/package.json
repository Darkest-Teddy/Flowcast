{
  "name": "flowcast-map-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "prepare:data": "python3 ../data-pipeline/build_map_data.py && python3 ../data-pipeline/build_class_directory.py && python3 ../data-pipeline/build_runtime_data.py && python3 ../data-pipeline/build_mobility_data.py && python3 ../data-pipeline/build_shuttle_schedule.py && node scripts/build-event-impact.mjs --if-stale",
    "prebuild": "npm run prepare:data",
    "test": "node --test tests/*.test.mjs",
    "validate:behavior": "node scripts/validate-behavior.mjs",
    "calibrate": "node scripts/calibrate-behavior.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@deck.gl/mesh-layers": "^9.4.0",
    "@loaders.gl/core": "^4.5.4",
    "@loaders.gl/gltf": "^4.5.4",
    "@luma.gl/engine": "^9.4.2",
    "mapbox-gl": "^3.33.0",
    "maplibre-gl": "^5.24.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
